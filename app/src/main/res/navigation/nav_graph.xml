<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/loginFragment">

    <!-- 로그인 -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.pet_walking.feature.Login.ui.LoginFragment"
        android:label="로그인"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_userFragment"
            app:destination="@id/userFragment" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <!-- 회원가입 -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.pet_walking.feature.Login.ui.RegisterFragment"
        android:label="회원가입"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- 홈 -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.pet_walking.feature.Home.HomeFragment"
        android:label="홈"
        tools:layout="@layout/home_fragment" />

    <!-- 러닝 -->
    <fragment
        android:id="@+id/runningFragment"
        android:name="com.example.pet_walking.feature.Running.ui.RunningFragment"
        android:label="러닝"
        tools:layout="@layout/running_fragment">
        <action
            android:id="@+id/action_runningFragment_to_runSummaryFragment"
            app:destination="@id/runSummaryFragment" />
    </fragment>

    <!-- 러닝 요약 -->
    <fragment
        android:id="@+id/runSummaryFragment"
        android:name="com.example.pet_walking.feature.Running.ui.RunSummaryFragment"
        android:label="러닝 요약"
        tools:layout="@layout/fragment_run_summary">
        <argument
            android:name="runStats"
            app:argType="com.example.pet_walking.feature.Running.model.RunStats" />
        <action
            android:id="@+id/action_runSummaryFragment_to_runningFragment"
            app:destination="@id/runningFragment" />
    </fragment>

    <!-- 사용자 프로필 -->
    <fragment
        android:id="@+id/userFragment"
        android:name="com.example.pet_walking.feature.profile.ui.UserFragment"
        android:label="사용자"
        tools:layout="@layout/user_fragment" />

    <!-- 통계 -->
    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.example.pet_walking.feature.statistics.StatisticsFragment"
        android:label="통계"
        tools:layout="@layout/statistics_fragment" />

    <!-- 목표 설정 -->
    <fragment
        android:id="@+id/goalFragment"
        android:name="com.example.pet_walking.feature.Goal.GoalFragment"
        android:label="목표"
        tools:layout="@layout/goal_fragment" />

    <!-- 지도 -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.pet_walking.feature.Running.Map.MapFragment"
        android:label="지도"
        tools:layout="@layout/map_fragment" />

    <!-- 채팅방 목록 -->
    <fragment
        android:id="@+id/chatRoomListFragment"
        android:name="com.example.pet_walking.feature.Chat.ChatRoomListFragment"
        android:label="채팅방 목록"
        tools:layout="@layout/fragment_chat_room_list">
        <action
            android:id="@+id/action_chatRoomListFragment_to_chatRoomFragment"
            app:destination="@id/chatRoomFragment" />
        <action
            android:id="@+id/action_chatRoomListFragment_to_createChatRoomFragment"
            app:destination="@id/createChatRoomFragment" />
        <action
            android:id="@+id/action_chatRoomListFragment_to_joinChatRoomFragment"
            app:destination="@id/joinChatRoomFragment" />
    </fragment>

    <!-- 채팅방 -->
    <fragment
        android:id="@+id/chatRoomFragment"
        android:name="com.example.pet_walking.feature.Chat.ChatRoomFragment"
        android:label="채팅방"
        tools:layout="@layout/fragment_chat_room">
        <argument
            android:name="roomId"
            app:argType="integer" />
        <argument
            android:name="userId"
            app:argType="string" />
    </fragment>

    <!-- 채팅방 생성 -->
    <fragment
        android:id="@+id/createChatRoomFragment"
        android:name="com.example.pet_walking.feature.Chat.CreateChatRoomFragment"
        android:label="채팅방 생성"
        tools:layout="@layout/fragment_create_chat_room">
        <action
            android:id="@+id/action_createChatRoomFragment_to_chatRoomFragment"
            app:destination="@id/chatRoomFragment" />
    </fragment>

    <!-- 채팅방 참여 -->
    <fragment
        android:id="@+id/joinChatRoomFragment"
        android:name="com.example.pet_walking.feature.Chat.JoinChatRoomFragment"
        android:label="채팅방 참여"
        tools:layout="@layout/fragment_join_chat_room">
        <action
            android:id="@+id/action_joinChatRoomFragment_to_chatRoomFragment"
            app:destination="@id/chatRoomFragment" />
    </fragment>

</navigation>